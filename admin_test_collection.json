{
    "info": {
        "name": "URL Shortener Admin Tests",
        "description": "Collection for testing admin functionality"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        },
        {
            "key": "adminToken",
            "value": ""
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "exec": [
                    "// Auto-extract token from login response",
                    "if (pm.response.code === 200 && pm.request.url.includes('/login')) {",
                    "    const response = pm.response.json();",
                    "    if (response.token) {",
                    "        pm.collectionVariables.set('adminToken', response.token);",
                    "    }",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "1. Admin Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/admin/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "2. Admin Dashboard",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "description": "Automatically set by login"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/dashboard",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "dashboard"
                    ]
                }
            }
        },
        {
            "name": "3. Get All URLs",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/urls",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "urls"
                    ]
                }
            }
        },
        {
            "name": "4. Get URL by ID",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/urls/1",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "urls",
                        "1"
                    ]
                }
            }
        },
        {
            "name": "5. Get Statistics",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/stats",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "stats"
                    ]
                }
            }
        },
        {
            "name": "6. Security Test - No Token",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/urls",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "urls"
                    ]
                }
            }
        },
        {
            "name": "7. Security Test - Invalid Token",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer invalid_token"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/urls",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "urls"
                    ]
                }
            }
        }
    ]
}